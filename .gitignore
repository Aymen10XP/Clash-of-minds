# ============================================
# Mind Clash - Root .gitignore
# Ionic React (Capacitor) + Django Backend
# ============================================

# --------------------------------------------
# Python / Django (server/)
# --------------------------------------------
venv/
env/
ENV/
.venv/
*.py[cod]
*$py.class
__pycache__/
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/
/static/
server/.env
server/.env.*
!server/.env.example

# Django migrations (optional - uncomment if you prefer not to commit)
# */migrations/*.py
# !*/migrations/__init__.py

# Celery
celerybeat-schedule
celerybeat.pid

# --------------------------------------------
# Node / Ionic / React (client/)
# --------------------------------------------
node_modules/
.turbo/
.npm-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
build/
www/
client/www/
client/dist/
client/build/

# Ionic / Vite
.ionic/
client/.ionic/
.vite/
client/.vite/

# Environment files
.env
.env.local
.env.*.local
client/.env
client/.env.*
!client/.env.example

# --------------------------------------------
# Capacitor / Android
# --------------------------------------------
# Native Android build outputs
client/android/app/build/
client/android/build/
client/android/.gradle/
client/android/gradle/
client/android/local.properties
client/android/.idea/
client/android/captures/
client/android/app/release/
*.apk
*.aab
*.ap_
*.dex
*.class

# Capacitor sync artifacts (regenerated by `npx cap sync`)
client/android/app/src/main/assets/public/
client/android/app/src/main/res/xml/config.xml

# Keystores and signing (NEVER commit these)
*.jks
*.keystore
keystore.properties
client/android/key.properties

# --------------------------------------------
# IDE / Editor
# --------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --------------------------------------------
# Testing & Coverage
# --------------------------------------------
coverage/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
client/coverage/
*.lcov

# --------------------------------------------
# Logs & Runtime
# --------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pids
*.pid
*.seed
*.pid.lock

# --------------------------------------------
# OS Files
# --------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --------------------------------------------
# Secrets & Certificates (CRITICAL)
# --------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.env.production
.env.staging

# --------------------------------------------
# Temporary / Cache
# --------------------------------------------
.cache/
.parcel-cache/
.temp/
.tmp/
tmp/
*.tmp
*.bak
*.orig

# Local project documentation
/docs/

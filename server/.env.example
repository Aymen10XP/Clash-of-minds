# Copy this file to server/.env for local development.
# Use different, secret values outside local development.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=clash_of_minds
POSTGRES_USER=clash_of_minds
POSTGRES_PASSWORD=clash_of_minds_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_CONN_MAX_AGE=60
FRONTEND_URL=http://localhost:5173
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@clashofminds.local
DJANGO_PASSWORD_RESET_TIMEOUT=3600
# For SMTP in production, use django.core.mail.backends.smtp.EmailBackend and set:
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True

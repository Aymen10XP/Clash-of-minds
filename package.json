{
  "name": "mind-clash",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:network": "node scripts/dev-network.mjs",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:docker": "npm run test:e2e:docker --workspace @mind-clash/client",
    "test:e2e:compatibility": "npm run test:e2e:compatibility --workspace @mind-clash/client",
    "evidence:generate": "node scripts/generate-quality-reports.mjs",
    "evidence:full": "node scripts/generate-quality-reports.mjs --include-e2e",
    "report:pdf": ".venv\\Scripts\\python.exe scripts\\generate-final-pdf.py",
    "report:docx": "uv run --no-project --with python-docx==1.2.0 python scripts\\generate-final-docx.py",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.5"
  },
  "allowScripts": {
    "cypress@16.3.0": true,
    "esbuild@0.28.2": true,
    "core-js@3.50.0": true
  }
}
